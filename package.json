{
  "name": "storytel-client",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial, security-first local web & PWA desktop client for Storytel audiobooks with Google SSO, offline MP3 downloads, custom collections, and Storytel-inspired UI.",
  "author": "Onur Sercan Yılmaz <onursercanyilmaz@users.noreply.github.com>",
  "homepage": "https://onursercanyilmaz.github.io/storytel-client/",
  "repository": {
    "type": "git",
    "url": "https://github.com/onursercanyilmaz/storytel-client.git"
  },
  "license": "MIT",
  "keywords": [
    "storytel",
    "audiobook",
    "player",
    "nextjs",
    "react",
    "pwa",
    "storytel-client"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build && node scripts/copy-standalone-assets.js",
    "start": "node scripts/start-server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "desktop:build": "next build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "electron": "33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.onursercanyilmaz.storytelclient",
    "productName": "Storytel Client",
    "copyright": "Copyright © 2026 Onur Sercan Yılmaz",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "public/icon.png"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": ["**/*"]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static",
        "filter": ["**/*"]
      },
      {
        "from": "public",
        "to": "standalone/public",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Storytel Client",
      "artifactName": "Storytel-Client-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Storytel-Client-Portable-${version}.${ext}"
    },
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "AudioVideo",
      "icon": "public/icon.png",
      "artifactName": "storytel-client_${version}_${arch}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.music",
      "icon": "public/icon.png",
      "artifactName": "Storytel-Client-${version}-${arch}.${ext}"
    }
  }
}
